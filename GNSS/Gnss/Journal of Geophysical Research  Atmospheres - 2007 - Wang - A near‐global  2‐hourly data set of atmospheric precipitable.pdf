<x:xmpmeta x:xmptk="Adobe XMP Core 4.2.1-c043 52.372728, 2009/01/18-15:08:04        " xmlns:x="adobe:ns:meta/">
   <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
      <rdf:Description rdf:about="" xmlns:dc="http://purl.org/dc/elements/1.1/">
         <dc:format>application/pdf</dc:format>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Global Change: Water cycles; Global Change: Instruments and techniques; Geodesy and Gravity: Atmosphere monitoring with geodetic techniques; Geodesy and Gravity: Global change from geodesy</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">A near&amp;hyphen;global, 2&amp;hyphen;hourly data set of atmospheric precipitable water from ground&amp;hyphen;based GPS measurements</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>Junhong Wang, Liangying Zhang, Aiguo Dai, Teresa Van Hove, Jo&amp;euml;l Van Baelen</rdf:li>
            </rdf:Seq>
         </dc:creator>
      </rdf:Description>
      <rdf:Description rdf:about="" xmlns:pdf="http://ns.adobe.com/pdf/1.3/">
         <pdf:Keywords>http://dx.doi.org/10.1029/2006JD007529, doi:10.1029/2006JD007529, precipitable water, GPS, water vapor</pdf:Keywords>
         <pdf:Producer>PDFlib PLOP 2.0.0p6 (SunOS)/Acrobat Distiller 4.05 for Windows; modified using iText 4.2.0 by 1T3XT</pdf:Producer>
