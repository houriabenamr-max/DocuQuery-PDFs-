            <rdf:Alt>
               <rdf:li xml:lang="x-default">Global Change: Remote sensing; Global Change: Water cycles; Global Change: Instruments and techniques; Hydrology: Hydrologic budget; Meteorology and Atmospheric Dynamics: Numerical modeling and data assimilation</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:title>
            <rdf:Alt>
